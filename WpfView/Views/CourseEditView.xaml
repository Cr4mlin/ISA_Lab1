<local:BaseView x:Class="WpfView.Views.CourseEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfView.Views"
        xmlns:converters="clr-namespace:WpfView.Converters"
        Title="Добавление/Редактирование курса" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название курса -->
        <TextBlock Grid.Row="0" Text="Название курса:" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="5"/>

        <!-- Описание -->
        <TextBlock Grid.Row="4" Text="Описание:" FontWeight="Bold"/>
        <TextBox Grid.Row="6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="5" Height="80"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Длительность -->
        <TextBlock Grid.Row="8" Text="Длительность (часы):" FontWeight="Bold"/>
        <TextBox Grid.Row="10" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="5"/>

        <!-- Цена -->
        <TextBlock Grid.Row="12" Text="Цена:" FontWeight="Bold"/>
        <TextBox Grid.Row="14" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="5"/>

        <!-- Преподаватель -->
        <TextBlock Grid.Row="16" Text="Преподаватель:" FontWeight="Bold"/>
        <TextBox Grid.Row="18" Text="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="5"/>

        <!-- Активен -->
        <CheckBox Grid.Row="20" Content="Курс активен" IsChecked="{Binding IsActive}"
                  VerticalAlignment="Center" FontSize="14" Margin="0,10,0,0"/>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="22" Text="{Binding ErrorMessage}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,5,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="24" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="35"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
            <Button Content="Отмена" Width="120" Height="35"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</local:BaseView>
