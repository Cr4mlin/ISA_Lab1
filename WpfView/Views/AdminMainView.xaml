<local:BaseView x:Class="WpfView.Views.AdminMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfView.Views"
        Title="Главная - Администратор" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FA88E6" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Аватарка -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                    <Border Width="50" Height="50" CornerRadius="25"
                            BorderBrush="White" BorderThickness="2"
                            Background="White">
                        <Image x:Name="AvatarImage" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="25,25" RadiusX="23" RadiusY="23"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Button Content="Изменить" VerticalAlignment="Center" Margin="10,0,0,0"
                            Click="ChangeAvatar_Click" Height="30" Width="80"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding NickName, StringFormat='Администратор: {0}'}"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Поиск курсов:" VerticalAlignment="Center"
                               Foreground="White" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200"
                             VerticalAlignment="Center"
                             FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <TabControl Grid.Row="1" Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <!-- Вкладка "Курсы" -->
            <TabItem Header="Управление курсами" x:Name="CoursesTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="100"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat='{}{0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Добавить курс" Width="150" Height="35"
                                    Margin="0,0,10,0"
                                    Command="{Binding AddCourseCommand}"/>
                            <Button Content="Экспорт" Width="150" Height="35"
                                    Command="{Binding ExportCommand}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Редактировать" Width="150" Height="35"
                                    Margin="0,0,10,0"
                                    Command="{Binding EditCourseCommand}"/>
                            <Button Content="Изменить статус" Width="150" Height="35"
                                    Margin="0,0,10,0"
                                    Command="{Binding ToggleCourseStatusCommand}"/>
                            <Button Content="Удалить курс" Width="150" Height="35"
                                    Command="{Binding DeleteCourseCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка "Пользователи" -->
            <TabItem Header="Управление пользователями" x:Name="UsersTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding NickName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="10">
                        <Button Content="Удалить пользователя" Width="180" Height="35"
                                Command="{Binding DeleteUserCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="Панель администратора"/>
        </StatusBar>
    </Grid>
</local:BaseView>
